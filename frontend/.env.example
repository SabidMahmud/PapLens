# PapLens Dual Backend Endpoints (with automatic client-side failover)

# Primary Backend: k3s Cluster (via Cloudflare Tunnel or direct HTTPS)
NEXT_PUBLIC_API_URL_PRIMARY=http://localhost:7860

# Fallback Backend: Hugging Face Spaces (Docker CPU SDK)
NEXT_PUBLIC_API_URL_FALLBACK=https://sabidmahmud-paplens.hf.space

# Comma-separated LAN hosts allowed to access Next.js development resources.
# This affects `next dev` only and is not needed for production builds.
NEXT_ALLOWED_DEV_ORIGINS=
