# Copy this file to backend/.env and replace the placeholder values.
# Never commit backend/.env or a real Hugging Face access token.

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required when model checkpoints are not present in backend/weights.
HF_REPO_ID=sabidmahmud/paplens-weights

# Leave blank for a public repository. Use a read-only token for a private repo.
HF_TOKEN=

# Inference runtime defaults.
DEVICE=cpu
TORCH_THREADS=4
MAX_CONCURRENT_INFERENCES=2
MAX_QUEUED_INFERENCES=5
INFERENCE_QUEUE_TIMEOUT_SECONDS=30
